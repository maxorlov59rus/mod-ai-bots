##################################
#  mod-ai-bots — AI-боты         #
##################################

# Включение модуля.
# По умолчанию: 0
AiBots.Enable = 1

# ID аккаунта (из базы auth, таблица account) для сессий ботов.
# Рекомендуется создать отдельный аккаунт ботов, например:
#   INSERT INTO account (id, username, sha_pass_hash, expansion)
#   VALUES (777, 'AIBOTS', '', 2);
# Если 0 — используется внутренний заглушечный аккаунт.
# По умолчанию: 0
AiBots.AccountId = 0

# Максимальное количество ботов на одного игрока.
# По умолчанию: 1
AiBots.MaxBotsPerPlayer = 1

# Автоматически создавать бота(ов) при входе игрока в мир.
# По умолчанию: 1
AiBots.AutoSpawn = 1

# Количество ботов, создаваемых автоматически при логине (если AutoSpawn включён).
# По умолчанию: 1
AiBots.AutoSpawnCount = 1

# Интервал обновления AI ботов в миллисекундах.
# По умолчанию: 500
AiBots.UpdateInterval = 500

# Разрешить ботам участвовать в бою (атака целей рядом с владельцем).
# По умолчанию: 1
AiBots.EnableCombat = 1

# Дистанция следования бота за владельцем (в ярдах).
# По умолчанию: 4.0
AiBots.FollowDistance = 4.0

# Команды .bot доступны всем игрокам (SEC_PLAYER).
# По умолчанию: 1
AiBots.CommandsForAll = 1

# Раса и класс бота по умолчанию в формате "race:class".
# 1 = Human, 2 = Orc, 3 = Dwarf, 4 = Night Elf, 5 = Undead,
# 6 = Tauren, 7 = Gnome, 8 = Troll, 10 = Blood Elf, 11 = Draenei.
# Классы: 1 = Warrior, 2 = Paladin, 3 = Hunter, 4 = Rogue, 5 = Priest,
#         7 = Shaman, 8 = Mage, 9 = Warlock, 11 = Druid.
# По умолчанию: "1:1" (человек-воин)
AiBots.DefaultRaceClass = "1:1"

##################################
#  Автономные боты в мире        #
##################################

# Включить автономных ботов, которые спавнятся в локациях без владельца,
# сами бьют мобов, дерутся с ботами враждебной фракции, используют навыки
# и общаются в чате.
# По умолчанию: 1
AiBots.WorldBots.Enable = 1

# Количество автономных ботов в мире.
# По умолчанию: 10
AiBots.WorldBots.Count = 10

# Режим выбора точек спавна автономных ботов. Варианты:
#   0 = из SQL-таблицы mod_ai_bots_locations (mapId, x, y, z, o),
#       точки можно менять в БД без пересборки;
#   1 = рядом с онлайн-игроками (случайный онлайн-игрок, смещение ~20 ярдов);
#   2 = случайные стартовые зоны (Элвиннский лес, Дуротар и т.п., встроенный список).
# По умолчанию: 0
AiBots.WorldBots.SpawnMode = 0

# Время возрождения автономного бота после смерти, в секундах.
# По умолчанию: 60
AiBots.WorldBots.RespawnSeconds = 60

# Использовать заклинания по классу бота (иначе только автоатака).
# По умолчанию: 1
AiBots.WorldBots.UseSpells = 1

# Разрешить автономным ботам писать в чат (Say/Yell).
# По умолчанию: 1
AiBots.WorldBots.Chat.Enable = 1

# Вероятность боевого клича при вступлении в бой, в процентах (0-100).
# По умолчанию: 30
AiBots.WorldBots.Chat.BattleCryChance = 30

# Вероятность случайной фразы при каждой проверке idle-чата, в процентах (0-100).
# По умолчанию: 2
AiBots.WorldBots.Chat.IdleChance = 2

##################################
#  Прокачка и тактика ботов      #
##################################

# Уровень автономных ботов при создании.
# По умолчанию: 5
AiBots.WorldBots.Level = 5

# Уровень ботов игрока синхронизируется с уровнем владельца при создании
# и обновляется при логине бота (0 = выключено, иначе = фикс. уровень).
# По умолчанию: 0 (выключено)
AiBots.SyncOwnerLevel = 0

# Порог здоровья (в процентах), ниже которого бот отступает от боя
# и убегает от цели. 0 = отступление выключено.
# По умолчанию: 20
AiBots.Tactics.FleeHealthPct = 20

# Порог здоровья (в процентах), ниже которого бот-лекарь лечит себя
# или владельца. 0 = лечение выключено.
# По умолчанию: 50
AiBots.Tactics.HealThresholdPct = 50

# Баффать себя и союзников перед боем.
# По умолчанию: 1
AiBots.Tactics.UseBuffs = 1

##################################
#  Генерация имён ботов          #
##################################

# Режим выбора имени бота. Варианты:
#   0 = из SQL-таблицы mod_ai_bots_names (с fallback-списком в коде);
#   1 = процедурный генератор (слоговый конструктор фэнтезийных имён,
#       тысячи комбинаций — подходит для крупных серверов);
#   2 = смешанный: сначала таблица, при исчерпании — генератор.
# По умолчанию: 2
AiBots.Names.Mode = 2

##################################
#  Живой мир                     #
##################################

# Патрулирование: радиус (в ярдах), в котором автономные боты ходят
# вокруг точки спавна, когда нет боя. 0 = стоят на месте.
# По умолчанию: 25
AiBots.WorldBots.Patrol.Radius = 25

# Прокачка автономных ботов: они получают опыт со временем и растут
# в уровнях в реальном времени.
# По умолчанию: 1
AiBots.WorldBots.Leveling = 1

# Шанс появления элитного бота при спавне, в процентах (0-100).
# Элитные боты на 10 уровней выше и кричат в бою громче.
# По умолчанию: 10
AiBots.WorldBots.EliteChance = 10

# Дуэли: боты противоположных фракций рядом устраивают короткие
# честные бои 1v1 с репликами.
# По умолчанию: 1
AiBots.WorldBots.Duels.Enable = 1

# Шанс дуэли при каждой встрече двух ботов враждебных фракций, % (0-100).
# По умолчанию: 5
AiBots.WorldBots.Duels.Chance = 5

# Группы: боты одной фракции объединяются в группы, лидер координирует
# атаку, лекари лечат раненых товарищей.
# По умолчанию: 1
AiBots.WorldBots.Groups.Enable = 1

# Максимальный размер группы ботов.
# По умолчанию: 5
AiBots.WorldBots.Groups.MaxSize = 5

# Боты-торговцы: игроки могут купить предметы у автономного бота-торговца
# (список товаров — в таблице mod_ai_bots_vendors, команды .bot shop / .bot buy).
# По умолчанию: 1
AiBots.Vendors.Enable = 1

# Количество ботов-торговцев в мире.
# По умолчанию: 3
AiBots.Vendors.Count = 3

# Территории: точки спавна "принадлежат" фракциям (mod_ai_bots_territory)
# и периодически переходят из рук в руки с объявлением в мир.
# По умолчанию: 1
AiBots.Territory.Enable = 1

# Раз в сколько минут происходит смена владельца одной из территорий.
# По умолчанию: 30
AiBots.Territory.FlipMinutes = 30

##################################
#  Гильдия ботов                 #
##################################

# Включить гильдию ботов: автономные боты вступают в гильдию своей фракции,
# которая прокачивается от их активности (убийства, уровни ботов).
# По умолчанию: 1
AiBots.Guild.Enable = 1

# Названия гильдий ботов — отдельные для каждой фракции.
# По умолчанию: "AI Vanguard" (Альянс) / "AI Legion" (Орда)
AiBots.Guild.AllianceName = "AI Vanguard"
AiBots.Guild.HordeName = "AI Legion"

# Опыт гильдии за одно убийство ботом (умножается на уровень жертвы).
# По умолчанию: 5
AiBots.Guild.XpPerKill = 5

# Базовое количество опыта для следующего уровня гильдии.
# Реально требуется: XpPerLevelBase * текущий_уровень_гильдии.
# По умолчанию: 1000
AiBots.Guild.XpPerLevelBase = 1000

# Максимальный уровень гильдии (как в Cataclysm).
# По умолчанию: 25
AiBots.Guild.MaxLevel = 25

##################################
#  Осады городов                 #
##################################

# Включить осады: отряд ботов эпизодически штурмует вражескую столицу,
# защита — боты и NPC гарнизона. Завершается победой/отступлением.
# По умолчанию: 1
AiBots.Siege.Enable = 1

# Минимальный интервал между осадами (случайный между Min и Max), в минутах.
# По умолчанию: 90 / 240
AiBots.Siege.IntervalMinMinutes = 90
AiBots.Siege.IntervalMaxMinutes = 240

# Размер атакующего отряда (случайно от Min до Max ботов).
# По умолчанию: 5 / 10
AiBots.Siege.AttackerMin = 5
AiBots.Siege.AttackerMax = 10

# Сколько минут длится осада до отступления атакующих.
# По умолчанию: 15
AiBots.Siege.DurationMinutes = 15

##################################
#  Питомцы ботов                 #
##################################

# Включить питомцев: охотники и чернокнижники призывают питомцев,
# которые сражаются рядом с ботом и следуют за ним.
# По умолчанию: 1
AiBots.Pets.Enable = 1

# Суммон каждые N секунд, если питомца нет (после смерти/отзыва).
# По умолчанию: 20
AiBots.Pets.SummonIntervalSeconds = 20

